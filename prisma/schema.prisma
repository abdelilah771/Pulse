generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  dailyMetrics DailyMetrics[]
}

model Task {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  priority  String   @default("medium") // high, medium, low
  type      String   @default("learn")  // learn, practice, read, review, project, celebrate
  dateStr   String   // e.g., "2026-02-23"

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dateStr])
}

model DailyMetrics {
  id        String   @id @default(cuid())
  dateStr   String   // e.g., "2026-02-23"
  mood      Int      @default(5)
  energy    Int      @default(5)
  coffee    Int      @default(0)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dateStr])
}
